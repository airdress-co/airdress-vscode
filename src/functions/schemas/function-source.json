{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.airdress.co/function/v1.json",
  "title": "Airdress Hosted Function Manifest v1",
  "description": "airdress.function/v1 manifest. Describes a hosted function's identity, requested capabilities, trigger bindings, and author-suggested limits.",
  "type": "object",
  "required": ["apiVersion", "id", "name", "version", "entry", "runtime", "minHost", "capabilities", "triggers"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "airdress.function/v1"
    },
    "id": {
      "type": "string",
      "description": "Reverse-DNS function identifier (e.g. co.airdress.example.summarize).",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
      "minLength": 3,
      "maxLength": 255
    },
    "name": {
      "type": "string",
      "description": "Human-readable name.",
      "minLength": 1,
      "maxLength": 255
    },
    "version": {
      "type": "string",
      "description": "Exact semver (no ranges).",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "entry": {
      "type": "string",
      "description": "The entry. 'function.wasm' for wasm-component/v1 and 'function.ts' for subprocess-deno/v1; for js-source/v1, the .ts, .mts, .js or .mjs file under src/ whose default export handles a request.",
      "anyOf": [
        { "enum": ["function.wasm", "function.ts"] },
        { "pattern": "^src/([^/\\\\]+/)*[^/\\\\]+\\.(ts|mts|js|mjs)$" }
      ]
    },
    "runtime": {
      "type": "string",
      "enum": ["wasm-component/v1", "subprocess-deno/v1", "js-source/v1"]
    },
    "minHost": {
      "type": "string",
      "description": "Minimum operator host version.",
      "pattern": "^airdress\\.function-host/\\d+\\.\\d+$"
    },
    "description": { "type": "string", "maxLength": 2000 },
    "author":      { "type": "string", "maxLength": 255 },
    "homepage":    { "type": "string", "format": "uri", "maxLength": 2000 },
    "repository":  { "type": "string", "format": "uri", "maxLength": 2000 },
    "icons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["src", "sizes"],
        "properties": {
          "src":     { "type": "string", "maxLength": 2000 },
          "sizes":   { "type": "string", "maxLength": 32 },
          "purpose": { "type": "string", "maxLength": 32 }
        },
        "additionalProperties": false
      },
      "maxItems": 8
    },
    "capabilities": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "description": "airdress:fn/<world>@<semver> identifier.",
            "pattern": "^airdress:fn/[a-z][a-z0-9-]*@\\d+\\.\\d+\\.\\d+$"
          },
          "scope": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "triggers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["http"]
          },
          "path": {
            "type": "string",
            "description": "HTTP path prefix (must start with '/').",
            "pattern": "^/[a-zA-Z0-9._~:@!$&'()*+,;=%/-]*$",
            "maxLength": 1024
          },
          "pass_headers": {
            "type": "array",
            "items": { "type": "string", "maxLength": 128 },
            "maxItems": 32
          }
        },
        "additionalProperties": false
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "cpu_deadline_ms": { "type": "integer", "minimum": 100, "maximum": 30000 },
        "memory_mib":      { "type": "integer", "minimum": 1,   "maximum": 512 },
        "fuel":            { "type": "integer", "minimum": 0 },
        "concurrency":     { "type": "integer", "minimum": 1,   "maximum": 64 },
        "llm": {
          "type": "object",
          "properties": {
            "token_budget": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "name":     { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64 },
              "type":     { "type": "string", "enum": ["string", "number", "boolean"] },
              "default":  {},
              "required": { "type": "boolean" },
              "description": { "type": "string", "maxLength": 500 }
            },
            "additionalProperties": false
          },
          "maxItems": 32
        }
      },
      "additionalProperties": false
    },
    "backend": {
      "type": "string",
      "description": "Name of a co-installed plugin the function calls via airdress:fn/plugin (post-MVP).",
      "maxLength": 255
    }
  }
}
