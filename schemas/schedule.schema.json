{
  "$id": "https://schemas.airdress.co/operator/Schedule/v1.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "A resource manifest applied to an Airdress operator.",
  "properties": {
    "apiVersion": {
      "const": "airdress.co/v1alpha1"
    },
    "kind": {
      "const": "Schedule"
    },
    "metadata": {
      "description": "The `metadata` block of a manifest.",
      "properties": {
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "type": "string"
        },
        "namespace": {
          "description": "Accepted for k8s familiarity but ignored — every operator manages one airdress's resources (one namespace).",
          "type": [
            "string",
            "null"
          ]
        },
        "resourceVersion": {
          "description": "Optimistic concurrency token. When present, apply is rejected with 409 if the stored row's `resource_version` doesn't match. When absent, last-writer-wins.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "description": "A cadence that fires a function this operator hosts. The schedule names its target and how often to run it; the function itself declares what it does and what it may reach.",
      "properties": {
        "concurrencyPolicy": {
          "default": "Forbid",
          "description": "What happens when a fire is still running and the next is due.",
          "oneOf": [
            {
              "description": "Fire regardless; overlapping runs are bounded only by the target's own concurrency limit.",
              "enum": [
                "Allow"
              ],
              "type": "string"
            },
            {
              "description": "Skip the new fire while the previous one is still running.",
              "enum": [
                "Forbid"
              ],
              "type": "string"
            },
            {
              "description": "Stop the previous fire and start the new one.",
              "enum": [
                "Replace"
              ],
              "type": "string"
            }
          ]
        },
        "cron": {
          "description": "A calendar expression, such as \"0 7 * * *\", for a wall-clock schedule. Set exactly one of every or cron.",
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "default": true,
          "description": "Whether this schedule fires. A disabled schedule is kept and validated but never runs.",
          "type": "boolean"
        },
        "every": {
          "description": "A duration between fires, such as \"10s\" or \"5m\". Use this for a simple repeating cadence. Set exactly one of every or cron.",
          "type": [
            "string",
            "null"
          ]
        },
        "request": {
          "additionalProperties": false,
          "default": {
            "headers": [],
            "method": "POST",
            "path": "/"
          },
          "description": "The request each fire hands the function, in place of the request an incoming call would have carried.",
          "properties": {
            "body": {
              "description": "Optional request body.",
              "type": [
                "string",
                "null"
              ]
            },
            "headers": {
              "default": [],
              "description": "Headers set on the request.",
              "items": {
                "additionalProperties": false,
                "description": "One request header. Its value is either written inline or drawn from a secret at the moment the schedule fires.",
                "properties": {
                  "name": {
                    "description": "Header name.",
                    "type": "string"
                  },
                  "value": {
                    "description": "A literal value. Anything written here is stored in the manifest and its published schema in the clear, so never put a secret here. Set exactly one of value or valueFrom.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "valueFrom": {
                    "additionalProperties": false,
                    "description": "A value read from a secret when the schedule fires. Use this for bearer tokens and anything else that must not be committed. Set exactly one of value or valueFrom.",
                    "properties": {
                      "secretRef": {
                        "description": "The name of a secret held by this operator.",
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "token": {
                        "additionalProperties": false,
                        "description": "A short-lived token this operator mints at each fire, scoped to one action on one resource. Nothing is stored: a peer that trusts this operator's public key verifies it.",
                        "properties": {
                          "action": {
                            "description": "The one action the token carries.",
                            "oneOf": [
                              {
                                "description": "Create or replace the resource.",
                                "enum": [
                                  "Apply"
                                ],
                                "type": "string"
                              },
                              {
                                "description": "Read the resource.",
                                "enum": [
                                  "Get"
                                ],
                                "type": "string"
                              },
                              {
                                "description": "Delete the resource.",
                                "enum": [
                                  "Delete"
                                ],
                                "type": "string"
                              },
                              {
                                "description": "Read the resource's status.",
                                "enum": [
                                  "ReadStatus"
                                ],
                                "type": "string"
                              }
                            ]
                          },
                          "resource": {
                            "description": "The one resource the token is good for, as Kind::name — for example Function::relay-to-op2.",
                            "type": "string"
                          },
                          "ttl": {
                            "description": "How long each minted token lives, as a number then s, m or h — at most 1h. Keep it near the schedule's interval: a token outliving its fire is only more to lose.",
                            "type": "string"
                          }
                        },
                        "required": [
                          "action",
                          "resource",
                          "ttl"
                        ],
                        "type": [
                          "object",
                          "null"
                        ]
                      }
                    },
                    "type": [
                      "object",
                      "null"
                    ]
                  }
                },
                "required": [
                  "name"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "method": {
              "default": "POST",
              "description": "HTTP method. Defaults to POST.",
              "type": "string"
            },
            "path": {
              "default": "/",
              "description": "Request path handed to the function. Defaults to \"/\".",
              "type": "string"
            }
          },
          "type": "object"
        },
        "target": {
          "additionalProperties": false,
          "description": "What this schedule fires.",
          "properties": {
            "kind": {
              "description": "The kind of thing to fire. Only Function is supported.",
              "oneOf": [
                {
                  "description": "A hosted function served at /fn/<name>.",
                  "enum": [
                    "Function"
                  ],
                  "type": "string"
                }
              ]
            },
            "name": {
              "description": "The name of the resource to fire.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        },
        "timezone": {
          "description": "The IANA time zone a cron expression is evaluated in, such as \"Europe/Berlin\". Ignored when every is used. Defaults to UTC.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "target"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "Airdress operator Schedule manifest",
  "type": "object",
  "x-airdress-operator-version": "v0.1.86"
}
